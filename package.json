{
  "name": "notix-nexus",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=packages/bot",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "dev": "concurrently \"npm run dev:bot\" \"npm run dev:dashboard\"",
    "build": "npm run build --workspaces",
    "start": "concurrently \"npm run start --workspace=packages/bot\" \"npm run start --workspace=packages/dashboard\"",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "eslint": "^9.15.0",
    "@types/node": "^22.10.0"
  }
}
