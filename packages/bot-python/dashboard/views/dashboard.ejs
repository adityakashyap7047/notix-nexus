<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Server — VARUNASTRA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="cyber-grid"></div>
  <canvas id="matrix-canvas"></canvas>
  <canvas id="particle-canvas"></canvas>
  <div class="scanlines"></div>

  <div class="nav">
    <a href="/" class="logo"><span class="pulse-dot"></span><span>VARUNASTRA</span></a>
    <div class="nav-r">
      <div style="display:flex;align-items:center;gap:0.6rem;">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" class="avatar" alt="">
        <span style="font-size:0.85rem;font-weight:500;"><%= user.username %></span>
      </div>
      <a href="/auth/logout" class="btn btn-s btn-sm">Logout</a>
    </div>
  </div>

  <div class="main" style="max-width:950px;margin:2.5rem auto;">

    <!-- ─── MAINTENANCE NOTICE ─── -->
    <div class="maintenance-banner" style="
      background: linear-gradient(135deg, rgba(234,179,8,0.08), rgba(239,68,68,0.06));
      border: 1px solid rgba(234,179,8,0.25);
      border-radius: var(--r);
      padding: 1.5rem 2rem;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
      animation: bannerPulse 3s ease-in-out infinite alternate;
    ">
      <div style="position:absolute;top:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,transparent,#eab308,#ef4444,transparent);animation:bannerScan 4s linear infinite;"></div>
      <div style="display:flex;align-items:flex-start;gap:1rem;">
        <span style="font-size:1.8rem;line-height:1;">⚙️</span>
        <div>
          <h3 style="font-size:1rem;font-weight:800;color:#eab308;margin-bottom:0.5rem;letter-spacing:-0.3px;">
            🚨 BOT DASHBOARD MAINTENANCE NOTICE
          </h3>
          <p style="font-size:0.85rem;color:var(--text2);line-height:1.7;margin-bottom:0.8rem;">
            The web dashboard is currently undergoing maintenance.
          </p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <div style="display:flex;align-items:center;gap:0.6rem;font-size:0.82rem;">
              <span style="color:var(--red);font-weight:700;">⚠️ Data Alert:</span>
              <span style="color:var(--text2);">Changes made via the dashboard may be <strong style="color:#ef4444;">temporarily unsaved or lost</strong>.</span>
            </div>
            <div style="display:flex;align-items:center;gap:0.6rem;font-size:0.82rem;">
              <span style="color:var(--green);font-weight:700;">✅ Bot Commands:</span>
              <span style="color:var(--text2);">All chat/slash commands inside Discord are <strong style="color:#22c55e;">100% operational</strong>.</span>
            </div>
          </div>
          <p style="font-size:0.78rem;color:var(--text3);margin-top:0.8rem;font-style:italic;">
            We'll post an announcement once the dashboard is fully restored. Thank you for your patience!
          </p>
        </div>
      </div>
    </div>
    <style>
      @keyframes bannerPulse { from{box-shadow:0 0 20px rgba(234,179,8,0.05)} to{box-shadow:0 0 40px rgba(234,179,8,0.12),0 0 60px rgba(239,68,68,0.06)} }
      @keyframes bannerScan { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }
    </style>

    <h1>Select a Server</h1>
    <p class="sub">Choose a server to configure. You need Manage Server permission.</p>

    <div class="card" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.8rem;">
      <span style="font-size:0.88rem;"><strong>Don't see your server?</strong> <span style="color:var(--text2);">Add the bot first.</span></span>
      <a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-p btn-sm">Add Bot</a>
    </div>

    <div class="sg">
      <% guilds.forEach(g => { %>
        <div class="sc reveal" style="<%= !g.botInServer ? 'opacity:0.4;' : '' %>">
          <% if (g.icon) { %><img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt=""><% } else { %><div class="ph"><%= g.name.charAt(0) %></div><% } %>
          <h3><%= g.name %></h3>
          <div class="sc-meta"><%= g.botInServer ? 'Bot Active' : 'Bot Not Installed' %></div>
          <% if (g.botInServer) { %>
            <a href="/dashboard/<%= g.id %>" class="btn btn-p btn-sm" style="margin-top:1rem;width:100%;justify-content:center;">Configure</a>
          <% } else { %>
            <a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= g.id %>" target="_blank" class="btn btn-s btn-sm" style="margin-top:1rem;width:100%;justify-content:center;">Add Bot</a>
          <% } %>
        </div>
      <% }); %>
    </div>
    <% if (!guilds.length) { %><div class="empty"><div class="ic">&#128194;</div><h3>No servers found</h3><p>You need Manage Server permission on a server.</p><a href="https://discord.com/api/oauth2/authorize?client_id=<%= bot.config.clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-p" style="margin-top:1rem;">Add Bot to a Server</a></div><% } %>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
